			"\t\ty>>=1;",
			"\t}",
			"\treturn cnt;",
			"}"
		]
	},
	"Calc": {
		"prefix": "Calc",
		"body": [
			"ll sum[N],inv[N];",
			"inline ll qpow (ll x,ll y) {",
			"\tll cnt=1;",
			"\twhile (y) {",
			"\t\tif (y&1) {",
			"\t\t\tcnt=cnt*x%mod;",
			"\t\t}",
			"\t\tx=x*x%mod;",
			"\t\ty>>=1;",
			"\t}",
			"\treturn cnt;",
			"}",
			"inline void init () {",
			"\tsum[0]=1;",
			"\tfor (ll i=1;i<N;i++) {",
			"\t\tsum[i]=sum[i-1]*i%mod;",
			"\t}",
			"\tinv[N-1]=qpow(sum[N-1],mod-2);",
			"\tfor (ll i=N-2;i>=0;i--) {",
			"\t\tinv[i]=inv[i+1]*(i+1)%mod;",
			"\t}",
			"}",
			"inline ll C (ll x,ll y) {",
			"\tif (x<y||y<0||x>=N) {",
			"\t\treturn 0;",
			"\t}",
			"\treturn sum[x]*inv[y]%mod*inv[x-y]%mod;",
			"}"
		]
	},
	"Segtree": {
		"prefix": "Segtree",
		"body": [
			"struct info {",
			"\tll val;",
			"\tinline void clear () {",
			"\t\tval=0;",
			"\t}",
			"};",
			"struct Tag {",
			"\tll val;",
			"\tinline void clear () {",
			"\t\tval=0;",
			"\t}",
			"};",
			"inline info operator + (info a,info b) {",
			"\ta.val+=b.val;",
			"\treturn a;",
			"}",
			"inline info operator + (info a,ll b) {",
			"\ta.val+=b;",
			"\treturn a;",
			"}",
			"inline info operator + (info a,Tag b) {",
			"\ta.val+=b.val;",
			"\treturn a;",
			"}",
			"inline Tag operator + (Tag a,Tag b) {",
			"\ta.val+=b.val;",
			"\treturn a;",
			"}",
			"inline Tag operator + (Tag a,ll b) {",
			"\ta.val+=b;",
			"\treturn a;",
			"}",
			"inline Tag operator * (Tag a,ll b) {",
			"\ta.val*=b;",
			"\treturn a;",
			"}",
			"struct Segtree {",
			"\tinfo t[N<<2];",
			"\tTag lt[N<<2];",
			"\tinline void push_up (ll pos) {",
			"\t\tt[pos]=t[pos<<1]+t[pos<<1|1];",
			"\t}",
			"\tinline void push_down (ll pos,ll l,ll r) {",
			"\t\tll mid=(l+r)>>1;",
			"\t\tt[pos<<1]=t[pos<<1]+lt[pos]*(mid-l+1);",
			"\t\tt[pos<<1|1]=t[pos<<1|1]+lt[pos]*(r-mid);",
			"\t\tlt[pos<<1]=lt[pos<<1]+lt[pos];",
			"\t\tlt[pos<<1|1]=lt[pos<<1|1]+lt[pos];",
			"\t\tlt[pos].clear();",
			"\t}",
			"\tvoid add (ll pos,ll l,ll r,ll L,ll R,ll val) {",
			"\t\tif (L<=l&&r<=R) {",
			"\t\t\tt[pos]=t[pos]+val*(r-l+1);",
			"\t\t\tlt[pos]=lt[pos]+val;",
			"\t\t\treturn ;",
			"\t\t}",
			"\t\tpush_down(pos,l,r);",
			"\t\tll mid=(l+r)>>1;",
			"\t\tif (L<=mid) {",
			"\t\t\tadd(pos<<1,l,mid,L,R,val);",
			"\t\t}",
			"\t\tif (R>mid) {",
			"\t\t\tadd(pos<<1|1,mid+1,r,L,R,val);",
			"\t\t}",
			"\t\tpush_up(pos);",
			"\t}",
			"\tinfo query (ll pos,ll l,ll r,ll L,ll R) {",
			"\t\tif (L<=l&&r<=R) {",
			"\t\t\treturn t[pos];",
			"\t\t}",
			"\t\tpush_down(pos,l,r);",
			"\t\tll mid=(l+r)>>1;",
			"\t\tinfo cnt;",
			"\t\tcnt.clear();",
			"\t\tif (L<=mid) {",
			"\t\t\tcnt=cnt+query(pos<<1,l,mid,L,R);",
			"\t\t}",
			"\t\tif (R>mid) {",
			"\t\t\tcnt=cnt+query(pos<<1|1,mid+1,r,L,R);",
			"\t\t}",
			"\t\treturn cnt;",
			"\t}",
			"};"
		]
	},
