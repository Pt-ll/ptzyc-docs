	"crt": {
		"prefix": "crt",
		"body": [
			"ll exgcd (ll a,ll b,ll &x,ll &y) {",
			"\tif (!b) {",
			"\t\tx=1,y=0;",
			"\t\treturn a;",
			"\t}",
			"\tll d=exgcd(b,a%b,y,x);",
			"\ty-=(a/b)*x;",
			"\treturn d;",
			"}",
			"inline ll CRT (ll n,ll *a,ll *b) {",
			"\tll num=1,ans=0;",
			"\tfor (ll i=1;i<=n;i++) {",
			"\t\tnum=num*a[i];",
			"\t}",
			"\tfor (ll i=1;i<=n;i++) {",
			"\t\tll kl=num/a[i],x,y;",
			"\t\texgcd(kl,a[i],x,y);",
			"\t\tans=(ans+b[i]%num*kl*x%num)%num;",
			"\t}",
			"\treturn (ans+num)%num;",
			"}"
		]
	},
	"excrt": {
		"prefix": "excrt",
		"body": [
			"ll exgcd (ll a,ll b,ll &x,ll &y) {",
			"\tif (!b) {",
			"\t\tx=1,y=0;",
			"\t\treturn a;",
			"\t}",
			"\tll d=exgcd(b,a%b,y,x);",
			"\ty-=(a/b)*x;",
			"\treturn d;",
			"}",
			"inline ll exCRT (ll n,ll *a,ll *b) {",
			"\tll bl=1,al=0;",
			"\tfor (ll i=1;i<=n;i++) {",
			"\t\tll x,y,d=exgcd(bl,b[i],x,y);",
			"\t\tx=(al-a[i])/d*x;",
			"\t\tal=al-bl*x;",
			"\t\tbl=b[i]/d*bl;",
			"\t\tal=(al%bl+bl)%bl;",
			"\t}",
			"\treturn al;",
			"}"
		]
	},
	"gauss": {
		"prefix": "gauss",
		"body": [
			"inline void gauss (ll n,ld a[][N],ld b[],ld ans[]) {",
			"\tfor (ll i=1;i<=n;i++) {",
			"\t\tll lt=i;",
			"\t\tfor (ll j=i;j<=n;j++) {",
			"\t\t\tif (fabs(a[j][i])>fabs(a[lt][i])) {",
			"\t\t\t\tlt=j;",
			"\t\t\t}",
			"\t\t}",
			"\t\tfor (ll j=1;j<=n;j++) {",
			"\t\t\tswap(a[lt][j],a[i][j]);",
			"\t\t}",
			"\t\tswap(b[i],b[lt]);",
			"\t\tif (fabs(a[i][i])<=eps) {",
			"\t\t\tcontinue;",
			"\t\t}",
			"\t\tfor (ll j=1;j<=n;j++) {",
			"\t\t\tif (i==j) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tld num=1.0*a[j][i]/a[i][i];",
			"\t\t\tfor (ll k=1;k<=n;k++) {",
			"\t\t\t\ta[j][k]-=num*a[i][k];",
			"\t\t\t}",
			"\t\t\tb[j]-=num*b[i];",
			"\t\t}",
			"\t}",
			"\tfor (ll i=1;i<=n;i++) {",
			"\t\tans[i]=b[i]/a[i][i];",
			"\t}",
			"}"
		]
	},
  "Mat": {
          "prefix": "Mat",
          "body": [
			"struct Mat {",
            "\tll n,m,a[N][N];",
            "\tMat (ll x,ll y) {",
            "\t\tn=x,m=y;",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=m;j++) {",
            "\t\t\t\ta[i][j]=0;",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "\tinline void init () {",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=m;j++) {",
            "\t\t\t\ta[i][j]=0;",
            "\t\t\t}",
            "\t\t\ta[i][i]=1;",
            "\t\t}",
            "\t}",
            "\tinline void input () {",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=m;j++) {",
            "\t\t\t\ta[i][j]=read();",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "\tinline void output () {",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=m;j++) {",
            "\t\t\t\tprint(a[i][j]);",
            "\t\t\t\tputchar(' ');",
            "\t\t\t}",
            "\t\t\tputs(\"\");",
            "\t\t}",
            "\t}",
            "\tinline Mat operator * (const Mat &b) {",
            "\t\tMat c(n,b.m);",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=b.m;j++) {",
            "\t\t\t\tfor (ll k=1;k<=m;k++) {",
            "\t\t\t\t\tc.a[i][j]+=a[i][k]*b.a[k][j]%mod;",
            "\t\t\t\t\tif (c.a[i][j]>=mod) {",
            "\t\t\t\t\t\tc.a[i][j]-=mod;",
            "\t\t\t\t\t}",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t}",
            "\t\treturn c;",
            "\t}",
            "\tinline Mat operator + (const Mat &b) {",
            "\t\tMat c(n,m);",
            "\t\tfor (ll i=1;i<=n;i++) {",
            "\t\t\tfor (ll j=1;j<=m;j++) {",
            "\t\t\t\tc.a[i][j]=a[i][j]+b.a[i][j];",
            "\t\t\t\tif (c.a[i][j]>=mod) {",
