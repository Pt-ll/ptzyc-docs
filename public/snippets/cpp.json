            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t}",
            "\t\treturn c;",
            "\t}",
            "};",
            "inline Mat qpow (Mat a,ll y) {",
            "\tMat ans(a.n,a.m);",
            "\tans.init();",
            "\twhile (y) {",
            "\t\tif (y&1) {",
            "\t\t\tans=ans*a;",
            "\t\t}",
